# Copy to .env and fill in.
GROQ_API_KEY=
# Two DIFFERENT models (problem statement requires distinct LLM stages). Check console.groq.com for current names/limits.
LLM1_MODEL=llama-3.3-70b-versatile
LLM2_MODEL=openai/gpt-oss-120b
LLM1_TPM=12000
LLM2_TPM=8000
LLM2_REASONING_EFFORT=medium

ASR_MODEL=large-v3
ASR_COMPUTE_TYPE=int8_float16

# Diarization (optional)
DIARIZE=false
HF_TOKEN=
# NUM_SPEAKERS=3

ACOUSTIC_CHECK=true
# Tuned with eval/tune_thresholds.py
TAU_CONF=6.0
TAU_GLOSSARY=3.0
STRONG_MARGIN=0.5

NLI_CHECK=false
USE_LLM_CACHE=true
